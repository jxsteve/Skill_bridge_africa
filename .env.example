# Optional overrides. Defaults are baked into src/auth/config.ts.
VITE_PRIVY_APP_ID=cmqy53hyi00mm0clerka9busw
VITE_PRIVY_CLIENT_ID=client-WY6aVHNxiVPo1nSnAraZWpPUPdcovfGV7NMx9kdHfYi8Z

# Supabase (data backend). Copy from your project's API settings.
# Without these, the app falls back to mock data. The anon key is public/safe to ship.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Set to 'true' ONLY after configuring the Privy->Supabase JWT bridge (production).
# In demo mode leave it unset/false so the app talks to Supabase as the anon role.
VITE_SUPABASE_FORWARD_PRIVY_JWT=false
